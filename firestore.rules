rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Projects and Services
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    
    match /projectsServices/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Portfolio
    match /portfolio/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid);
    }

    // Ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Bookmarks, SentRequests, EnrolledProjects
    match /bookmarks/{itemId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    
    match /sentRequests/{requestId} {
      allow read, write: if isAuthenticated();
    }
    
    match /enrolledProjects/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // Wallet & Transactions
    match /wallets/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /transactions/{txnId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow client-side creation for now
      allow update, delete: if false; // Transactions should be immutable
    }
    
    match /withdraw_requests/{requestId} {
      allow read, create: if isAuthenticated();
    }
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
    }
    
    match /requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // Disputes
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Allow updates for status changes
    }

    // Saved Cards
    match /savedCards/{cardId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
